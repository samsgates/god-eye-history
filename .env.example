# App
NODE_ENV=development
PORT=8787
PUBLIC_APP_URL=http://localhost:4173
API_BASE_URL=http://localhost:8787
JWT_SECRET=replace-with-a-long-random-value

# Cesium / Maps
CESIUM_ION_TOKEN=
GOOGLE_MAPS_API_KEY=
OPENHISTORICALMAP_STYLE_URL=https://www.openhistoricalmap.org/map-styles/main/main.json

# Database / cache / search
DATABASE_URL=postgres://postgres:postgres@localhost:5432/godeyehistory
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200

# AI routing
DEFAULT_AI_PROVIDER=auto
AI_FALLBACK_PROVIDER=gemini
AI_SECONDARY_FALLBACK=claude

OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_REASONING_MODEL=gpt-5.6-sol

GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
CLAUDE_FAST_MODEL=claude-sonnet-5
CLAUDE_REASONING_MODEL=claude-opus-5

# Historical sources
EUROPEANA_API_KEY=
WIKIMEDIA_USER_AGENT=god-eye-history/1.0 (contact@example.com)

# Present-day optional providers
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
NASA_FIRMS_MAP_KEY=
TOMTOM_API_KEY=
TFL_APP_KEY=

# Google login (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8787/api/auth/google/callback

# Mail / magic links (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=history@example.com
